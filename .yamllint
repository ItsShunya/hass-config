# Run with `make lint`, same as CI.
extends: default

# Third-party files, plus two gitignored ones that may exist locally.
ignore: |
  custom_components/
  www/plugins/
  themes/
  blueprints/*/homeassistant/
  secrets.yaml

rules:
  # Home Assistant files don't start with "---".
  document-start: disable
  line-length:
    max: 120
  comments:
    # Allow commented-out keys ("#bluetooth:") and short inline notes.
    require-starting-space: false
    min-spaces-from-content: 1
  truthy:
    # GitHub Actions workflows use "on:" as a key.
    check-keys: false

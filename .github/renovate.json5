{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // Only list updates in the dashboard issue, no PRs. Vendored code has to be
  // replaced by hand (docs/vendored.md), bumping the version isn't enough.
  dependencyDashboardApproval: true,
  dependencyDashboardAutoclose: true,
  dependencyDashboardTitle: "Updates available",
  dependencyDashboardLabels: ["updates"],

  // The built-in homeassistant-manifest manager would also list every
  // integration's Python requirements, which we don't manage.
  enabledManagers: ["custom.regex", "github-actions"],

  packageRules: [
    {
      // For actions the version bump is the whole update, so open a PR.
      description: "GitHub Actions used by the workflows",
      matchManagers: ["github-actions"],
      dependencyDashboardApproval: false,
      groupName: "GitHub Actions",
    },
  ],

  // Integrations and cards use "loose" versioning: the default skips the map
  // extractor's v3.0.0-alpha-N releases, and semver sorts alpha-9 above alpha-24.

  customManagers: [
    {
      description: "Home Assistant version in .HA_VERSION",
      customType: "regex",
      managerFilePatterns: ["/^\\.HA_VERSION$/"],
      matchStrings: ["^(?<currentValue>\\S+)"],
      depNameTemplate: "home-assistant",
      packageNameTemplate: "ghcr.io/home-assistant/home-assistant",
      datasourceTemplate: "docker",
      versioningTemplate: "pep440",
    },
    {
      description: "Vendored integrations: version and upstream repository from manifest.json",
      customType: "regex",
      managerFilePatterns: ["/^custom_components/[^/]+/manifest\\.json$/"],
      matchStrings: [
        '"domain": "(?<depName>[^"]+)"[\\s\\S]*?"issue_tracker": "https://github\\.com/(?<packageName>[^/]+/[^/]+)/issues"[\\s\\S]*?"version": "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "loose",
    },
    {
      description: "Vendored cards: version from the ?v= suffix, repository from the renovate comment above it",
      customType: "regex",
      managerFilePatterns: ["/^configuration\\.yaml$/"],
      matchStrings: [
        // "- url: ..." under lovelace.resources, or a bare "- ..." under
        // frontend.extra_module_url.
        "# renovate: repo=(?<packageName>\\S+)\\n\\s*- (?:url: )?/local/plugins/(?<depName>[^/]+)/[^?\\s]+\\?v=(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "loose",
    },
  ],
}

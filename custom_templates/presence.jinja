{#-
  Returns JSON with each person and whether they're home, e.g.
  {"person.alice": true, "person.bob": false}.

  Only people with a device tracker count. Someone is home if their person is
  home, or if their phone's Wi-Fi sensor (from the Home Assistant app) shows
  one of the home_wifi networks.
-#}
{%- macro presence(home_wifi) -%}
  {%- set ns = namespace(people={}) -%}
  {%- for person in states.person if person.attributes.device_trackers -%}
    {#- The Wi-Fi sensor is on the same device as the tracker. -#}
    {%- set networks = person.attributes.device_trackers
        | map('device_id') | reject('none')
        | map('device_entities') | sum(start=[])
        | select('search', '_(wi_fi_connection|ssid)$')
        | map('states') | list -%}
    {%- set home = person.state == 'home'
        or networks | select('in', home_wifi) | list | count > 0 -%}
    {%- set ns.people = dict(ns.people, **{person.entity_id: home}) -%}
  {%- endfor -%}
  {{- ns.people | to_json -}}
{%- endmacro -%}
